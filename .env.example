# BHAIRAV City Safety System — Environment Configuration
# Copy to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────
BHAIRAV_SECRET=change-me-to-a-random-64-char-string
BHAIRAV_CORS_ORIGINS=https://your-domain.com
BHAIRAV_LOG_LEVEL=INFO
BHAIRAV_RETENTION_DAYS=30

# ── SMS Gateway (Twilio) ──────────────────────────────────────────
BHAIRAV_SMS_GATEWAY=twilio
BHAIRAV_TWILIO_SID=your_account_sid
BHAIRAV_TWILIO_TOKEN=your_auth_token
BHAIRAV_TWILIO_FROM=+1234567890

# ── Database (optional, for production) ────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/bhairav

# ── Monitoring ────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Camera Feeds ──────────────────────────────────────────────────
# RTSP://admin:pass@192.168.1.100:554/stream1
# BHAIRAV_CAMEROS=camera1,camera2,camera3
