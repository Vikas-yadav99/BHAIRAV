# Normalize line endings so the repo is stable across Windows/Linux/macOS
* text=auto

# Source files: always LF (matches CI on Linux)
*.py      text eol=lf
*.js      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.sh      text eol=lf

# Binaries / generated artifacts: never normalize
*.png     binary
*.jpg     binary
*.mp4     binary
*.avi     binary
*.onnx    binary
*.pth     binary
*.zip     binary
*.db      binary
*.db-wal  binary
*.db-shm  binary
